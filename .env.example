# Токен бота от @BotFather
BOT_TOKEN=bot_token

# Бесплатный статический домен ngrok (dashboard.ngrok.com → Domains), без https://
NGROK_DOMAIN=your-name.ngrok-free.app

# Порт локального сервера
PORT=8080

# Необязательно:
# PUBLIC_URL=https://...            # если используешь не ngrok, а свой адрес
# WEBAPP_SHORT_NAME=dice            # если создавал Mini App через /newapp, а не «Configure Mini App»
# ENTRY_MODE=private                # кнопка в группе ведёт в личку с ботом (если нет постоянного адреса)
# DEV_MODE=1                        # локальная проверка в браузере без Telegram
